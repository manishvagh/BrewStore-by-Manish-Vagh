{
  "name": "brewstore",
  "productName": "BrewStore",
  "version": "1.1.1",
  "description": "App Store–style desktop GUI for Homebrew on macOS.",
  "author": "Manish Vagh",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "dist": "npm run build && cross-env ELECTRON_RUN_AS_NODE= electron-builder --mac dir",
    "install:mac": "node scripts/install-mac.cjs",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "build": {
    "appId": "app.manishvagh.brewstore",
    "productName": "BrewStore",
    "copyright": "Copyright © Manish Vagh",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manishvagh/BrewStore-by-Manish-Vagh.git"
  },
  "bugs": {
    "url": "https://github.com/manishvagh/BrewStore-by-Manish-Vagh/issues"
  },
  "homepage": "https://manishvagh.in/"
}
